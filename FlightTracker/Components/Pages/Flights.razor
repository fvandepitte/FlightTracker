@page "/flights"
@rendermode InteractiveServer

<PageTitle>Flights</PageTitle>

<div class="flights-container">
    <div class="flights-header">
        <h1>Flight Tracker</h1>
        <p class="subtitle">Track the flights you have done last year.</p>
    </div>

    <div class="flight-card add-flight-card">
        <h2 class="card-header">Add Flight</h2>
        <EditForm Model="@this" OnValidSubmit="AddFlight">
            <div class="form-grid">
                <div class="form-group">
                    <label for="flightNumber" class="form-label">Flight Number</label>
                    <InputText id="flightNumber" @bind-Value="newFlightNumber" class="form-input" placeholder="e.g., AA123" />
                </div>
                <div class="form-group">
                    <label for="flightDate" class="form-label">Flight Date</label>
                    <InputDate id="flightDate" @bind-Value="newFlightDate" class="form-input" />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-meta btn-primary" disabled="@(!IsFormValid())">
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                    </svg>
                    Add Flight
                </button>
            </div>
        </EditForm>
    </div>

    @if (flights.Count == 0)
    {
        <div class="empty-state">
            <svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
                <path d="M6.428 1.151C6.708.591 7.213 0 8 0s1.292.592 1.572 1.151C9.861 1.73 10 2.431 10 3v3.691l5.17 2.585a1.5 1.5 0 0 1 .83 1.342V12a.5.5 0 0 1-.582.493l-5.507-.918-.375 2.253 1.318 1.318A.5.5 0 0 1 10.5 16h-5a.5.5 0 0 1-.354-.854l1.319-1.318-.376-2.253-5.507.918A.5.5 0 0 1 0 12v-1.382a1.5 1.5 0 0 1 .83-1.342L6 6.691V3c0-.568.14-1.271.428-1.849Zm.894.448C7.111 2.02 7 2.569 7 3v4a.5.5 0 0 1-.276.447l-5.448 2.724a.5.5 0 0 0-.276.447v.792l5.418-.903a.5.5 0 0 1 .575.41l.5 3a.5.5 0 0 1-.14.437L6.708 15h2.586l-.647-.646a.5.5 0 0 1-.14-.436l.5-3a.5.5 0 0 1 .576-.411L15 11.41v-.792a.5.5 0 0 0-.276-.447L9.276 7.447A.5.5 0 0 1 9 7V3c0-.432-.11-.979-.322-1.401C8.458 1.159 8.213 1 8 1c-.213 0-.458.158-.678.599Z"/>
            </svg>
            <h3>No flights tracked yet</h3>
            <p>Add your first flight above to get started!</p>
        </div>
    }
    else
    {
        <div class="flight-card flights-list-card">
            <div class="card-header-row">
                <h2 class="card-header">Your Flights</h2>
                <span class="flight-count">@flights.Count</span>
            </div>
            <div class="flights-table">
                <div class="table-header">
                    <div class="table-cell header-cell">Flight Number</div>
                    <div class="table-cell header-cell">Date</div>
                    <div class="table-cell header-cell">Actions</div>
                </div>
                @foreach (var flight in flights.OrderByDescending(f => f.Date))
                {
                    <div class="table-row">
                        <div class="table-cell">
                            <svg class="flight-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M6.428 1.151C6.708.591 7.213 0 8 0s1.292.592 1.572 1.151C9.861 1.73 10 2.431 10 3v3.691l5.17 2.585a1.5 1.5 0 0 1 .83 1.342V12a.5.5 0 0 1-.582.493l-5.507-.918-.375 2.253 1.318 1.318A.5.5 0 0 1 10.5 16h-5a.5.5 0 0 1-.354-.854l1.319-1.318-.376-2.253-5.507.918A.5.5 0 0 1 0 12v-1.382a1.5 1.5 0 0 1 .83-1.342L6 6.691V3c0-.568.14-1.271.428-1.849Zm.894.448C7.111 2.02 7 2.569 7 3v4a.5.5 0 0 1-.276.447l-5.448 2.724a.5.5 0 0 0-.276.447v.792l5.418-.903a.5.5 0 0 1 .575.41l.5 3a.5.5 0 0 1-.14.437L6.708 15h2.586l-.647-.646a.5.5 0 0 1-.14-.436l.5-3a.5.5 0 0 1 .576-.411L15 11.41v-.792a.5.5 0 0 0-.276-.447L9.276 7.447A.5.5 0 0 1 9 7V3c0-.432-.11-.979-.322-1.401C8.458 1.159 8.213 1 8 1c-.213 0-.458.158-.678.599Z"/>
                            </svg>
                            <span class="flight-number">@flight.FlightNumber</span>
                        </div>
                        <div class="table-cell">
                            @flight.Date.ToString("dddd, MMMM d, yyyy")
                        </div>
                        <div class="table-cell">
                            <button @onclick="() => RemoveFlight(flight.Id)" class="btn-meta btn-secondary">
                                <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                </svg>
                                Remove
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Flight> flights = new();
    private string newFlightNumber = string.Empty;
    private DateOnly newFlightDate = DateOnly.FromDateTime(DateTime.Today);
    
    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(newFlightNumber);
    }
    
    private void AddFlight()
    {
        if (IsFormValid())
        {
            flights.Add(new Flight 
            { 
                Id = flights.Count > 0 ? flights.Max(f => f.Id) + 1 : 1,
                FlightNumber = newFlightNumber.Trim(),
                Date = newFlightDate
            });
            
            // Clear form
            newFlightNumber = string.Empty;
            newFlightDate = DateOnly.FromDateTime(DateTime.Today);
        }
    }
    
    private void RemoveFlight(int id)
    {
        var flight = flights.FirstOrDefault(f => f.Id == id);
        if (flight != null)
        {
            flights.Remove(flight);
        }
    }
    
    private class Flight
    {
        public int Id { get; set; }
        public string FlightNumber { get; set; } = string.Empty;
        public DateOnly Date { get; set; }
    }
}
